@model Web.Controllers.ManufacturingIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Manufacturing Breakdown";

    var breakdown = Model.Breakdown;

    string Num(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}

<link rel="stylesheet" href="~/css/manufacturing.css" asp-append-version="true" />

<div class="cc-topbar">
    <div>
        <h1 class="cc-page-title">Manufacturing Breakdown</h1>
        <p class="cc-page-meta">Recognise parts from a general arrangement drawing and generate a dimensioned manufacturing sheet for each one.</p>
    </div>

    <div class="d-flex gap-2">
        @if (breakdown is { Success: true } && Model.SelectedProjectId.HasValue)
        {
            <a class="cc-btn cc-btn-ghost" asp-controller="Manufacturing" asp-action="Export" asp-route-id="@Model.SelectedProjectId">Export CSV</a>
        }

    </div>
</div>

@if (TempData["Error"] is string errorMessage)
{
    <div class="cc-alert cc-alert-error" role="alert">@errorMessage</div>
}

<div class="row">
    <div class="col-xl-8">
        <form asp-controller="Manufacturing" asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-4" data-cc-upload-form>
            <div class="cc-dropzone" data-cc-dropzone>
                <input type="file"
                       id="mfg-file"
                       name="file"
                       class="cc-dropzone-input"
                       accept=".dxf"
                       aria-label="General arrangement DXF drawing"
                       data-cc-dropzone-input
                       required />

                <span class="cc-dropzone-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 16V4" />
                        <path d="M7 9l5-5 5 5" />
                        <path d="M5 20h14" />
                    </svg>
                </span>

                <p class="cc-dropzone-title">Drop a general arrangement DXF here, or click to browse</p>
                <p class="cc-dropzone-hint">DXF only, up to 20 MB. Parts are recognised from the drawing geometry.</p>
                <p class="cc-file-name" data-cc-file-name hidden></p>
                <ul class="cc-file-list" data-cc-file-list hidden></ul>
            </div>

            <div class="d-flex align-items-center gap-3 mt-3">
                <button type="submit" class="cc-btn cc-btn-primary" data-cc-submit>Upload and break down</button>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <form id="bom-form"
              asp-controller="Manufacturing"
              asp-action="BomSheets"
              method="post"
              enctype="multipart/form-data"
              class="mb-4"
              data-report-url="@Url.Action("BomSheetReport", "Manufacturing")">
            <p class="cc-mfg-detail-heading">Part sheets from BOM</p>
            <p class="cc-dropzone-hint">Upload a BOM (.csv or .json). Each part sheet is generated from the BOM sizes, not from the drawing lines.</p>

            <div class="d-flex flex-wrap gap-3 align-items-end mt-2">
                <div>
                    <label for="bom-file" class="cc-mfg-label">BOM file</label>
                    <input type="file" id="bom-file" name="bomFile" accept=".csv,.json" required />
                </div>
                <div>
                    <label for="bom-project" class="cc-mfg-label">Job no.</label>
                    <input type="text" id="bom-project" name="projectCode" class="cc-mfg-select" maxlength="40" />
                </div>
                <div>
                    <label for="bom-material" class="cc-mfg-label">Default material</label>
                    <input type="text" id="bom-material" name="defaultMaterial" class="cc-mfg-select" value="MS" maxlength="40" />
                </div>
                <div>
                    <label for="bom-thickness" class="cc-mfg-label">Default thickness (mm)</label>
                    <input type="number" id="bom-thickness" name="defaultThickness" class="cc-mfg-select" min="0" step="any" />
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 mt-3">
                <button type="button" id="bom-check" class="cc-btn cc-btn-ghost">Check BOM</button>
                <button type="submit" class="cc-btn cc-btn-primary">Generate part sheets</button>
            </div>
        </form>

        <div id="bom-status" class="cc-alert" role="status" hidden></div>
        <ul id="bom-issues" class="cc-mfg-list" hidden></ul>
    </div>
</div>

<form method="get" asp-controller="Manufacturing" asp-action="Index" class="cc-mfg-picker">
    <label for="mfg-project" class="cc-mfg-label">Drawing</label>
    <select id="mfg-project" name="id" class="cc-mfg-select" onchange="this.form.submit()">
        <option value="">Select a DXF drawing</option>
        @foreach (var project in Model.Projects)
        {
            <option value="@project.Id" selected="@(Model.SelectedProjectId == project.Id)">@project.Title</option>
        }
    </select>
    <noscript><button type="submit" class="cc-btn cc-btn-primary">Open</button></noscript>
</form>

@if (Model.SelectedProjectId.HasValue)
{
    <section class="cc-mfg-dxf-panel" aria-labelledby="mfg-dxf-heading">
        <h2 id="mfg-dxf-heading" class="cc-page-title">Manufacturing DXF files</h2>
        <p class="cc-page-meta">Each recognised part is exported as its own manufacturing sheet with true circles, dimensions, material, thickness, quantity and weight. Values not found in the drawing are never invented. Enter them below.</p>

        <form id="mfg-dxf-package-form" asp-controller="Manufacturing" asp-action="DownloadManufacturingDxfPackage" method="post" class="cc-mfg-picker">
            <input type="hidden" name="id" value="@Model.SelectedProjectId" />

            <label for="mfg-project-code" class="cc-mfg-label">Project ID</label>
            <input id="mfg-project-code" name="projectCode" type="text" maxlength="60" class="cc-mfg-select" placeholder="PRJ-@Model.SelectedProjectId.Value.ToString("D5")" />

            <label for="mfg-default-material" class="cc-mfg-label">Material</label>
            <input id="mfg-default-material" name="defaultMaterial" type="text" maxlength="60" class="cc-mfg-select" placeholder="e.g. MS IS 2062" />

            <label for="mfg-default-thickness" class="cc-mfg-label">Thickness (mm)</label>
            <input id="mfg-default-thickness" name="defaultThickness" type="number" step="0.1" min="0" class="cc-mfg-select" />

            <label for="mfg-origin" class="cc-mfg-label">Local origin</label>
            <select id="mfg-origin" name="origin" class="cc-mfg-select">
                <option value="BottomLeft" selected="selected">Bottom-left corner at 0,0</option>
                <option value="Center">Bounding-box center at 0,0</option>
            </select>

            <label class="cc-mfg-label">
                <input type="checkbox" name="includeReferenceGeometry" value="true" />
                Include centerlines and hidden lines (REF layer)
            </label>

            <label for="mfg-cut-layers" class="cc-mfg-label">Cut layers (comma-separated, blank = automatic)</label>
            <input id="mfg-cut-layers" name="cutLayers" type="text" class="cc-mfg-select" placeholder="e.g. 0, CUT, OUTLINE" />

            <label class="cc-mfg-label">
                <input type="checkbox" name="includeAllParts" value="true" />
                Keep every part (disable small-fragment and open-profile filters)
            </label>

            <button type="submit" class="cc-btn cc-btn-primary">Generate Manufacturing DXF Package</button>
        </form>

        <form id="mfg-ga-form" asp-controller="Manufacturing" asp-action="GaPackage" method="post" class="cc-mfg-picker">
            <input type="hidden" name="id" value="@Model.SelectedProjectId" />

            <label for="mfg-ga-project-code" class="cc-mfg-label">Project ID</label>
            <input id="mfg-ga-project-code" name="projectCode" type="text" maxlength="60" class="cc-mfg-select" placeholder="PRJ-@Model.SelectedProjectId.Value.ToString("D5")" />

            <label for="mfg-ga-material" class="cc-mfg-label">Material</label>
            <input id="mfg-ga-material" name="defaultMaterial" type="text" maxlength="60" class="cc-mfg-select" placeholder="e.g. MS IS 2062" />

            <label for="mfg-ga-thickness" class="cc-mfg-label">Thickness (mm)</label>
            <input id="mfg-ga-thickness" name="defaultThickness" type="number" step="0.1" min="0" class="cc-mfg-select" />

            <button type="submit" class="cc-btn cc-btn-primary">Generate GA Manufacturing Package (DXF + Cut List + Completeness Report)</button>
            <button type="submit" formaction="@Url.Action("GaReport", "Manufacturing")" formtarget="_blank" class="cc-btn cc-btn-ghost">View Completeness Report</button>
        </form>

        <form asp-controller="Manufacturing" asp-action="DownloadComponentDxf" method="post" class="cc-mfg-picker">
            <input type="hidden" name="id" value="@Model.SelectedProjectId" />

            <label for="mfg-node-id" class="cc-mfg-label">Component ID</label>
            <input id="mfg-node-id" name="nodeId" type="text" maxlength="20" class="cc-mfg-select" placeholder="ITEM-01" required />

            <label for="mfg-part-name" class="cc-mfg-label">Part name</label>
            <input id="mfg-part-name" name="partName" type="text" maxlength="60" class="cc-mfg-select" />

            <label for="mfg-part-material" class="cc-mfg-label">Material</label>
            <input id="mfg-part-material" name="material" type="text" maxlength="60" class="cc-mfg-select" />

            <label for="mfg-part-thickness" class="cc-mfg-label">Thickness (mm)</label>
            <input id="mfg-part-thickness" name="thickness" type="number" step="0.1" min="0" class="cc-mfg-select" />

            <label for="mfg-part-quantity" class="cc-mfg-label">Quantity</label>
            <input id="mfg-part-quantity" name="quantity" type="number" step="1" min="1" class="cc-mfg-select" />

            <label for="mfg-part-origin" class="cc-mfg-label">Local origin</label>
            <select id="mfg-part-origin" name="origin" class="cc-mfg-select">
                <option value="BottomLeft" selected="selected">Bottom-left corner at 0,0</option>
                <option value="Center">Bounding-box center at 0,0</option>
            </select>

            <button type="submit" class="cc-btn cc-btn-ghost">Download component DXF</button>
        </form>
    </section>
}

@if (Model.Projects.Count == 0)
{
    <div class="cc-mfg-empty">
        <h2>No DXF drawings yet</h2>
        <p>Block-based breakdown works on DXF drawings. Upload one above to begin.</p>
    </div>
}
else if (breakdown is null)
{
    <div class="cc-mfg-empty">
        <h2>Choose a drawing</h2>
        <p>Pick a drawing above to see its parts, quantities and sizes.</p>
    </div>
}
else if (!breakdown.Success)
{
    <div class="cc-alert cc-alert-error" role="alert">@(breakdown.ErrorMessage ?? "The breakdown could not be built.")</div>
}
else
{
    <div class="cc-mfg-summary">
        <div class="cc-mfg-stat">
            <span class="cc-mfg-stat-value">@breakdown.Parts.Count</span>
            <span class="cc-mfg-stat-label">Unique parts</span>
        </div>
        <div class="cc-mfg-stat">
            <span class="cc-mfg-stat-value">@breakdown.TotalInstances</span>
            <span class="cc-mfg-stat-label">Total instances</span>
        </div>
        <div class="cc-mfg-stat">
            <span class="cc-mfg-stat-value">@breakdown.TotalBlockDefinitions</span>
            <span class="cc-mfg-stat-label">Block definitions</span>
        </div>
    </div>

    @foreach (var warning in breakdown.Warnings)
    {
        <div class="cc-alert cc-alert-note" role="status">@warning</div>
    }

    @if (breakdown.Parts.Count > 0)
    {
        <div class="cc-table-wrap">
            <table class="cc-mfg-table">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Part (block)</th>
                        <th scope="col">Qty</th>
                        <th scope="col">Width</th>
                        <th scope="col">Height</th>
                        <th scope="col">Layer</th>
                        <th scope="col">Entities</th>
                        <th scope="col">Labels</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var item = 0; }
                    @foreach (var part in breakdown.Parts)
                    {
                        item++;
                        <tr>
                            <td>@item</td>
                            <td class="cc-mfg-name">@part.BlockName</td>
                            <td><strong>@part.Quantity</strong></td>
                            <td>@Num(part.Width)</td>
                            <td>@Num(part.Height)</td>
                            <td>@(string.IsNullOrWhiteSpace(part.Layer) ? "-" : part.Layer)</td>
                            <td>
                                @part.LineCount L, @part.ArcCount A, @part.CircleCount C, @part.PolylineCount P
                            </td>
                            <td>@(part.Labels.Count == 0 ? "-" : string.Join(", ", part.Labels))</td>
                        </tr>

                        @if (part.Placements.Count > 0 || part.Attributes.Count > 0)
                        {
                            <tr class="cc-mfg-detail-row">
                                <td></td>
                                <td colspan="7">
                                    <details>
                                        <summary>Details for @part.BlockName</summary>

                                        @if (part.Attributes.Count > 0)
                                        {
                                            <p class="cc-mfg-detail-heading">Attributes</p>
                                            <ul class="cc-mfg-list">
                                                @foreach (var attr in part.Attributes)
                                                {
                                                    <li><strong>@attr.Key:</strong> @attr.Value</li>
                                                }
                                            </ul>
                                        }

                                        @if (part.Placements.Count > 0)
                                        {
                                            <p class="cc-mfg-detail-heading">Placements (@part.Placements.Count)</p>
                                            <ul class="cc-mfg-list">
                                                @foreach (var placement in part.Placements)
                                                {
                                                    <li>X @Num(placement.X), Y @Num(placement.Y), rotation @Num(placement.Rotation)&deg;, scale @Num(placement.ScaleX) x @Num(placement.ScaleY)</li>
                                                }
                                            </ul>
                                        }
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('bom-form');
            if (!form) { return; }

            var status = document.getElementById('bom-status');
            var list = document.getElementById('bom-issues');
            var checkButton = document.getElementById('bom-check');

            function showStatus(text, kind) {
                status.textContent = text;
                status.className = 'cc-alert ' + kind;
                status.hidden = false;
            }

            function showIssues(issues) {
                list.innerHTML = '';
                issues.forEach(function (issue) {
                    var item = document.createElement('li');
                    item.textContent = '[' + String(issue.severity).toUpperCase() + '] ' + issue.part + ' (' + issue.code + '): ' + issue.message;
                    list.appendChild(item);
                });
                list.hidden = issues.length === 0;
            }

            async function runReport() {
                var response = await fetch(form.getAttribute('data-report-url'), { method: 'POST', body: new FormData(form) });
                var data = null;
                try { data = await response.json(); } catch (e) { data = null; }

                if (!response.ok || !data) {
                    showIssues([]);
                    showStatus((data && data.error) || 'The BOM could not be checked.', 'cc-alert-error');
                    return null;
                }

                showIssues(data.issues || []);
                showStatus(
                    data.sheetCount + ' of ' + data.requestedCount + ' part sheets can be generated.' + (data.hasErrors ? ' Some parts were skipped. See the list below.' : ''),
                    data.hasErrors ? 'cc-alert-error' : 'cc-alert-success');
                return data;
            }

            function fileNameFrom(response) {
                var header = response.headers.get('Content-Disposition') || '';
                var match = /filename\*?=(?:UTF-8'')?"?([^";]+)"?/i.exec(header);
                return match ? decodeURIComponent(match[1]) : 'part-sheets.zip';
            }

            checkButton.addEventListener('click', async function () {
                if (!form.reportValidity()) { return; }
                checkButton.disabled = true;
                try { await runReport(); } finally { checkButton.disabled = false; }
            });

            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                if (!form.reportValidity()) { return; }

                var submit = form.querySelector('button[type="submit"]');
                submit.disabled = true;

                try {
                    var report = await runReport();
                    if (!report || report.sheetCount === 0) { return; }

                    var response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                    if (!response.ok) {
                        showStatus('The part sheet package could not be generated.', 'cc-alert-error');
                        return;
                    }

                    var blob = await response.blob();
                    var url = URL.createObjectURL(blob);
                    var link = document.createElement('a');
                    link.href = url;
                    link.download = fileNameFrom(response);
                    document.body.appendChild(link);
                    link.click();
                    link.remove();
                    URL.revokeObjectURL(url);
                } finally {
                    submit.disabled = false;
                }
            });
        })();
    </script>
}
