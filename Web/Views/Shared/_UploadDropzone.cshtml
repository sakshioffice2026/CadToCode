<div class="cc-dropzone" data-cc-dropzone>
    <input type="file"
           id="files"
           name="files"
           class="cc-dropzone-input"
           accept=".dxf,.png,.jpg,.jpeg"
           aria-label="Drawing files"
           data-cc-dropzone-input
           multiple
           required />

    <span class="cc-dropzone-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 16V4" />
            <path d="M7 9l5-5 5 5" />
            <path d="M5 20h14" />
        </svg>
    </span>

    <p class="cc-dropzone-title">Drop drawings here, or click to browse</p>
    <p class="cc-dropzone-hint">DXF, PNG or JPG, up to 20 MB each. Select several files to upload them together.</p>
    <p class="cc-file-name" data-cc-file-name hidden></p>
    <ul class="cc-file-list" data-cc-file-list hidden></ul>
</div>
