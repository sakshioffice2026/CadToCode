@model string

<section class="cc-code-panel" aria-labelledby="cc-code-title">
    <div class="cc-code-header">
        <h2 class="cc-code-title" id="cc-code-title">Generated C# classes</h2>
        <button type="button"
                class="cc-btn cc-btn-small cc-copy-btn"
                data-cc-copy-target="#cc-code"
                data-cc-copy-label="Copy code">
            Copy code
        </button>
    </div>

    <pre class="cc-code-body" tabindex="0"><code id="cc-code" class="language-csharp" data-cc-highlight>@Model</code></pre>
</section>
