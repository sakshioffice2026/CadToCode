<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] - CadToCode</title>
    <link rel="icon" href="~/favicon.ico" />
