@model Web.Models.ProjectResultViewModel
@using System.Globalization
@using System.Text
@using CadToCode.Models.Dtos
@using CadToCode.Models.Enums

@{
    ViewData["Title"] = Model.Project.Title;

    var project = Model.Project;

    var parts = project.Components
        .Where(c => c.ComponentType == ComponentType.Cylinder || c.ComponentType == ComponentType.Cone || IsRect(c))
        .OrderBy(c => c.SequenceIndex)
        .ToList();

    string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    double Height(ComponentDto c) => (double)(c.Height ?? 0m);
    bool IsRect(ComponentDto c) => c.ComponentType == ComponentType.Door || c.ComponentType == ComponentType.Window || c.ComponentType == ComponentType.Duct || c.ComponentType == ComponentType.Generic || c.ComponentType.IsProfile();
    double Widest(ComponentDto c) => (double)Math.Max(c.Width ?? 0m, Math.Max(c.Diameter ?? 0m, Math.Max(c.TopDiameter ?? 0m, c.BottomDiameter ?? 0m)));

    string SvgLabel(double x, double y, string content) =>
        $"<text x=\"{N(x)}\" y=\"{N(y)}\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"14\" font-weight=\"600\" font-family=\"JetBrains Mono, Cascadia Code, Consolas, monospace\" fill=\"#e8eefb\" stroke=\"#0a0e18\" stroke-width=\"4\" paint-order=\"stroke\">{content}</text>";

    const double canvasWidth = 400;
    const double canvasHeight = 420;
    const double centerX = canvasWidth / 2;
    const double usableWidth = 320;
    const double usableHeight = 340;

    var totalHeight = parts.Sum(Height);
    var maxWidth = parts.Count > 0 ? parts.Max(Widest) : 0;
    var scale = totalHeight > 0 && maxWidth > 0 ? Math.Min(usableWidth / maxWidth, usableHeight / totalHeight) : 0;
    var cursorY = (canvasHeight - totalHeight * scale) / 2;

    var statusText = project.Status.ToString();

    var tTree = Model.Assembly.Tree;
    var tBounds = tTree.Bounds;
    var useTree = Model.HasAssembly && tBounds.Width > 0 && tBounds.Height > 0;
    var tSpan = Math.Max(tBounds.Width, tBounds.Height);
    var tPad = tSpan * 0.06;
    var tViewWidth = tBounds.Width + tPad * 2;
    var tViewHeight = tBounds.Height + tPad * 2;
    var tHatchStep = tSpan / 80.0;
    var tFont = tSpan / 38.0;

    string P(double value) => value.ToString("0.####", CultureInfo.InvariantCulture);
    double Tx(double value) => value - tBounds.MinX + tPad;
    double Ty(double value) => tBounds.MaxY - value + tPad;

    string TreeLabel(double lx, double ly, string content) =>
        $"<text x=\"{P(lx)}\" y=\"{P(ly)}\" class=\"cc-svg-assembly-label\" font-size=\"{P(tFont)}\">{System.Net.WebUtility.HtmlEncode(content)}</text>";

    string Pt(double x, double y) => P(Tx(x)) + " " + P(Ty(y));

    string ArcTo(double radius, bool large, bool clockwise, double x, double y) =>
        "A" + P(radius) + " " + P(radius) + " 0 " + (large ? "1" : "0") + " " + (clockwise ? "1" : "0") + " " + Pt(x, y);

    void AppendCircle(StringBuilder sb, double cx, double cy, double r)
    {
        if (r <= 0)
        {
            return;
        }

        sb.Append('M').Append(Pt(cx - r, cy))
          .Append(ArcTo(r, true, false, cx + r, cy))
          .Append(ArcTo(r, true, false, cx - r, cy))
          .Append('Z');
    }

    void AppendArc(StringBuilder sb, GeometryArc arc)
    {
        if (arc.Radius <= 0)
        {
            return;
        }

        var sweep = (arc.EndAngle - arc.StartAngle) % 360.0;
        if (sweep <= 0)
        {
            sweep += 360.0;
        }

        if (sweep >= 359.99)
        {
            AppendCircle(sb, arc.Center.X, arc.Center.Y, arc.Radius);
            return;
        }

        var a0 = arc.StartAngle * Math.PI / 180.0;
        var a1 = a0 + sweep * Math.PI / 180.0;

        sb.Append('M').Append(Pt(arc.Center.X + arc.Radius * Math.Cos(a0), arc.Center.Y + arc.Radius * Math.Sin(a0)))
          .Append(ArcTo(arc.Radius, sweep > 180.0, false, arc.Center.X + arc.Radius * Math.Cos(a1), arc.Center.Y + arc.Radius * Math.Sin(a1)));
    }

    void AppendPolyline(StringBuilder sb, GeometryPolyline poly)
    {
        var v = poly.Vertices;
        if (v.Count < 2)
        {
            return;
        }

        sb.Append('M').Append(Pt(v[0].X, v[0].Y));

        var segments = poly.IsClosed ? v.Count : v.Count - 1;
        for (var i = 0; i < segments; i++)
        {
            var a = v[i];
            var b = v[(i + 1) % v.Count];

            if (Math.Abs(a.Bulge) <= 1e-9)
            {
                sb.Append('L').Append(Pt(b.X, b.Y));
                continue;
            }

            var dx = b.X - a.X;
            var dy = b.Y - a.Y;
            var chord = Math.Sqrt(dx * dx + dy * dy);
            if (chord <= 1e-12)
            {
                continue;
            }

            var radius = chord * (1.0 + a.Bulge * a.Bulge) / (4.0 * Math.Abs(a.Bulge));
            sb.Append(ArcTo(radius, Math.Abs(a.Bulge) > 1.0, a.Bulge < 0, b.X, b.Y));
        }

        if (poly.IsClosed)
        {
            sb.Append('Z');
        }
    }

    string NodeGeometrySvg(AssemblyNode node)
    {
        var geo = node.Geometry;
        var b = node.Bounds;
        var output = new StringBuilder();

        output.Append("<rect class=\"cc-svg-hit\" x=\"").Append(P(Tx(b.MinX)))
              .Append("\" y=\"").Append(P(Ty(b.MaxY)))
              .Append("\" width=\"").Append(P(b.Width))
              .Append("\" height=\"").Append(P(b.Height)).Append("\" />");

        var hatch = new StringBuilder();
        foreach (var h in geo.Hatches)
        {
            foreach (var path in h.BoundaryPaths)
            {
                if (path.Count < 3)
                {
                    continue;
                }

                hatch.Append('M').Append(Pt(path[0].X, path[0].Y));
                for (var i = 1; i < path.Count; i++)
                {
                    hatch.Append('L').Append(Pt(path[i].X, path[i].Y));
                }
                hatch.Append('Z');
            }
        }

        var stroke = new StringBuilder();

        foreach (var line in geo.Lines)
        {
            stroke.Append('M').Append(Pt(line.Start.X, line.Start.Y))
                  .Append('L').Append(Pt(line.End.X, line.End.Y));
        }

        foreach (var poly in geo.Polylines)
        {
            AppendPolyline(stroke, poly);
        }

        foreach (var arc in geo.Arcs)
        {
            AppendArc(stroke, arc);
        }

        foreach (var circle in geo.Circles)
        {
            AppendCircle(stroke, circle.Center.X, circle.Center.Y, circle.Radius);
        }

        if (stroke.Length == 0 && hatch.Length == 0)
        {
            var round = node.Shape == PartShape.Circular || node.Shape == PartShape.Annular;
            if (round)
            {
                output.Append("<ellipse class=\"cc-svg-fallback\" cx=\"").Append(P(Tx(b.CenterX)))
                      .Append("\" cy=\"").Append(P(Ty(b.CenterY)))
                      .Append("\" rx=\"").Append(P(b.Width / 2.0))
                      .Append("\" ry=\"").Append(P(b.Height / 2.0)).Append("\" />");
            }
            else
            {
                output.Append("<rect class=\"cc-svg-fallback\" x=\"").Append(P(Tx(b.MinX)))
                      .Append("\" y=\"").Append(P(Ty(b.MaxY)))
                      .Append("\" width=\"").Append(P(b.Width))
                      .Append("\" height=\"").Append(P(b.Height)).Append("\" />");
            }

            return output.ToString();
        }

        if (hatch.Length > 0)
        {
            output.Append("<path class=\"cc-svg-hatch-fill\" fill=\"url(#cc-tree-hatch)\" fill-rule=\"evenodd\" d=\"")
                  .Append(hatch).Append("\" />");
        }

        if (stroke.Length > 0)
        {
            output.Append("<path class=\"cc-svg-geo\" d=\"").Append(stroke).Append("\" />");
        }

        return output.ToString();
    }
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Quantico:wght@400;700&amp;display=swap" />
<link rel="stylesheet" href="~/css/sandbox.css" asp-append-version="true" />

<style>
    .cc-entity-svg .cc-svg-geo {
        fill: none;
        stroke: var(--cc-part-stroke, #38bdf8);
        stroke-width: 1.4px;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
        pointer-events: none;
        transition: stroke 0.12s ease, stroke-width 0.12s ease;
    }

    .cc-entity-svg .cc-svg-hatch-fill {
        stroke: none;
        pointer-events: none;
    }

    .cc-entity-svg .cc-svg-node rect.cc-svg-hit {
        fill: transparent !important;
        stroke: none !important;
        pointer-events: all;
    }

    .cc-entity-svg .cc-svg-node:hover rect.cc-svg-hit {
        fill: rgba(56, 189, 248, 0.08) !important;
    }

    .cc-entity-svg .cc-svg-node:hover .cc-svg-geo {
        stroke: #7dd3fc;
        stroke-width: 2px;
    }

    .cc-entity-svg g.cc-entity-active rect.cc-svg-hit {
        fill: rgba(255, 122, 89, 0.12) !important;
        stroke: none !important;
    }

    .cc-entity-svg g.cc-entity-active .cc-svg-geo {
        stroke: var(--cc-accent-deep, #ff9d84);
        stroke-width: 2.6px;
    }

    .cc-entity-svg .cc-svg-node:focus-visible .cc-svg-geo {
        stroke: var(--cc-accent-deep, #ff9d84);
        stroke-width: 2.6px;
    }
</style>

<div class="cc-topbar">
    <div>
        <h1 class="cc-page-title">@project.Title</h1>
        <p class="cc-page-meta">
            @project.OriginalFileName
            &nbsp;|&nbsp; @(project.SourceFileType == SourceFileType.Dxf ? "DXF drawing" : "Image drawing")
            &nbsp;|&nbsp; <span class="cc-chip @(project.Status == ProjectStatus.Processed ? string.Empty : "cc-chip-muted")">@statusText</span>
        </p>
    </div>

    <div class="d-flex gap-2">
        <a class="cc-btn cc-btn-ghost" asp-controller="Project" asp-action="Download" asp-route-id="@project.Id">Download original</a>
        <a class="cc-btn cc-btn-primary" asp-controller="Project" asp-action="Upload">Upload another</a>
    </div>
</div>

@if (TempData["Error"] is string errorMessage)
{
    <div class="cc-alert cc-alert-error" role="alert">@errorMessage</div>
}

@if (TempData["Success"] is string successMessage)
{
    <div class="cc-alert cc-alert-success" role="status">@successMessage</div>
}

@if (project.Status == ProjectStatus.Failed)
{
    <div class="cc-alert cc-alert-error" role="alert">
        This drawing could not be analyzed. @project.ErrorMessage
    </div>
}

<nav class="cc-toolbar" aria-label="Workspace views">
    <button type="button" class="cc-tool-btn" data-cc-open="cc-modal-design" aria-haspopup="dialog" aria-controls="cc-modal-design">
        <span class="cc-tool-icon" aria-hidden="true">&#128065;&#65039;</span>
        <span class="cc-tool-label">View Design Preview</span>
    </button>
    <button type="button" class="cc-tool-btn" data-cc-open="cc-modal-3d" aria-haspopup="dialog" aria-controls="cc-modal-3d">
        <span class="cc-tool-icon" aria-hidden="true">&#129482;</span>
        <span class="cc-tool-label">Open 3D Preview</span>
    </button>
    <button type="button" class="cc-tool-btn" data-cc-open="cc-modal-components" aria-haspopup="dialog" aria-controls="cc-modal-components">
        <span class="cc-tool-icon" aria-hidden="true">&#128202;</span>
        <span class="cc-tool-label">Recognized Components</span>
    </button>
    <button type="button" class="cc-tool-btn" data-cc-open="cc-modal-breakdown" aria-haspopup="dialog" aria-controls="cc-modal-breakdown">
        <span class="cc-tool-icon" aria-hidden="true">&#128194;</span>
        <span class="cc-tool-label">Component Breakdown</span>
    </button>
    <button type="button" class="cc-tool-btn ca-toggle" data-ca-toggle aria-controls="cc-assist" aria-expanded="false">
        <span class="cc-tool-icon" aria-hidden="true">&#9889;</span>
        <span class="cc-tool-label">CAD Assistant</span>
    </button>
</nav>

<div class="cc-workspace">
    <partial name="_CodePreview" model="Model" />
</div>


<dialog class="cc-modal" id="cc-modal-design" aria-labelledby="cc-modal-design-title">
    <div class="cc-modal-shell">
        <header class="cc-modal-header">
            <h2 class="cc-modal-title" id="cc-modal-design-title">Design Preview</h2>
            <span class="cc-chip cc-chip-muted">Drawn from recognized values</span>
            <button type="button" class="cc-modal-close" data-cc-close aria-label="Close design preview">&times;</button>
        </header>

        <div class="cc-modal-body">
            <div class="cc-panel-body">
                <div class="cc-preview-frame">
                    @if (useTree)
                    {
                        <svg class="cc-entity-svg" viewBox="0 0 @P(tViewWidth) @P(tViewHeight)" width="100%" style="max-width: 36rem;" role="img" aria-label="Schematic of the detected assemblies">
                            <defs>
                                <pattern id="cc-tree-hatch" width="@P(tHatchStep)" height="@P(tHatchStep)" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                                    <line x1="0" y1="0" x2="0" y2="@P(tHatchStep)" stroke="#38bdf8" stroke-opacity="0.55" stroke-width="@P(tHatchStep / 8.0)" />
                                </pattern>
                            </defs>

                            @if (tTree.Assemblies.Count > 0)
                            {
                                foreach (var assembly in tTree.Assemblies)
                                {
                                    var members = assembly.NodeIds.ToHashSet(StringComparer.OrdinalIgnoreCase);

                                    <g class="cc-svg-assembly" data-entity-id="@assembly.Id">
                                        <rect class="cc-svg-assembly-box"
                                              x="@P(Tx(assembly.Bounds.MinX))"
                                              y="@P(Ty(assembly.Bounds.MaxY))"
                                              width="@P(assembly.Bounds.Width)"
                                              height="@P(assembly.Bounds.Height)" />
                                        @Html.Raw(TreeLabel(Tx(assembly.Bounds.MinX), Ty(assembly.Bounds.MaxY) - tFont * 0.4, assembly.AssemblyName))

                                        @foreach (var node in tTree.Nodes.Where(n => members.Contains(n.Id)))
                                        {
                                            var round = node.Shape == PartShape.Circular || node.Shape == PartShape.Annular;
                                            var hatched = node.HatchCount > 0 || node.IsFilled;

                                            <g class="cc-svg-node"
                                               data-entity-id="@node.Id"
                                               data-assembly-id="@assembly.Id"
                                               data-profile-id="@node.SharedProfileId"
                                               tabindex="0">
                                                <title>@node.Name</title>
                                                @Html.Raw(NodeGeometrySvg(node))
                                            </g>
                                        }
                                    </g>
                                }
                            }
                            else
                            {
                                foreach (var node in tTree.Nodes)
                                {
                                    var round = node.Shape == PartShape.Circular || node.Shape == PartShape.Annular;
                                    var hatched = node.HatchCount > 0 || node.IsFilled;

                                    <g class="cc-svg-node" data-entity-id="@node.Id" data-profile-id="@node.SharedProfileId" tabindex="0">
                                        <title>@node.Name</title>
                                        @Html.Raw(NodeGeometrySvg(node))
                                    </g>
                                }
                            }
                        </svg>
                    }
                    else if (parts.Count > 0 && scale > 0)
                    {
                        <svg viewBox="0 0 @N(canvasWidth) @N(canvasHeight)" width="100%" style="max-width: 26rem;" role="img" aria-label="Schematic of the recognized components">
                            <defs>
                                <pattern id="cc-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                                    <line x1="0" y1="0" x2="0" y2="6" stroke="#38bdf8" stroke-opacity="0.55" stroke-width="1" />
                                </pattern>
                            </defs>

                            <line x1="@N(centerX)" y1="10" x2="@N(centerX)" y2="@N(canvasHeight - 10)" stroke="#64748b" stroke-width="1" stroke-dasharray="8 4 2 4" />

                            @foreach (var part in parts)
                            {
                                var h = Height(part) * scale;

                                if (part.ComponentType == ComponentType.Cylinder)
                                {
                                    var w = (double)(part.Diameter ?? 0m) * scale;
                                    var x = centerX - w / 2;
                                    var cylinderLabel = "&#8960;" + N((double)(part.Diameter ?? 0m)) + " x " + N((double)(part.Height ?? 0m));

                                    <rect x="@N(x)" y="@N(cursorY)" width="@N(w)" height="@N(h)" style="fill: var(--cc-part-fill);" stroke="#38bdf8" stroke-width="2" />
                                    if (part.HasHatch)
                                    {
                                        <rect x="@N(x)" y="@N(cursorY)" width="@N(w)" height="@N(h)" fill="url(#cc-hatch)" stroke="none" />
                                    }
                                    <g>@Html.Raw(SvgLabel(centerX, cursorY + h / 2, cylinderLabel))</g>
                                }
                                else if (IsRect(part))
                                {
                                    var rw = (double)(part.Width ?? 0m) * scale;
                                    var rx = centerX - rw / 2;
                                    var rectLabel = N((double)(part.Width ?? 0m)) + " x " + N((double)(part.Height ?? 0m));

                                    <rect x="@N(rx)" y="@N(cursorY)" width="@N(rw)" height="@N(h)" style="fill: var(--cc-part-fill);" stroke="#38bdf8" stroke-width="2" />
                                    if (part.HasHatch)
                                    {
                                        <rect x="@N(rx)" y="@N(cursorY)" width="@N(rw)" height="@N(h)" fill="url(#cc-hatch)" stroke="none" />
                                    }
                                    <g>@Html.Raw(SvgLabel(centerX, cursorY + h / 2, rectLabel))</g>
                                }
                                else
                                {
                                    var top = (double)(part.TopDiameter ?? 0m) * scale;
                                    var bottom = (double)(part.BottomDiameter ?? 0m) * scale;
                                    var points = $"{N(centerX - top / 2)},{N(cursorY)} {N(centerX + top / 2)},{N(cursorY)} {N(centerX + bottom / 2)},{N(cursorY + h)} {N(centerX - bottom / 2)},{N(cursorY + h)}";
                                    var coneLabel = N((double)(part.Angle ?? 0m)) + "&deg; cone";

                                    <polygon points="@points" style="fill: var(--cc-part-fill);" stroke="#38bdf8" stroke-width="2" stroke-linejoin="round" />
                                    if (part.HasHatch)
                                    {
                                        <polygon points="@points" fill="url(#cc-hatch)" stroke="none" />
                                    }
                                    <g>@Html.Raw(SvgLabel(centerX, cursorY + h / 2, coneLabel))</g>
                                }

                                cursorY += h;
                            }
                        </svg>
                    }
                    else
                    {
                        <div class="cc-preview-empty">
                            <p class="cc-empty-title">Nothing to preview yet</p>
                            <p class="mb-0">The preview appears once a component is recognized.</p>
                        </div>
                    }
                </div>

                @if (Model.IsImageSource)
                {
                    <p class="cc-page-meta mt-3 mb-2">Original upload</p>
                    <img class="cc-preview-img"
                         src="@Url.Action("Download", "Project", new { id = project.Id })"
                         alt="Original uploaded drawing" />
                }
            </div>
        </div>
    </div>
</dialog>

<dialog class="cc-modal" id="cc-modal-3d" aria-labelledby="cc-modal-3d-title">
    <div class="cc-modal-shell">
        <header class="cc-modal-header">
            <h2 class="cc-modal-title" id="cc-modal-3d-title">3D Preview</h2>
            <span class="cc-chip cc-chip-muted" data-cc-viewer-status>Press Run to build the solid</span>
            <button type="button" class="cc-modal-close" data-cc-close aria-label="Close 3D preview">&times;</button>
        </header>

        <div class="cc-modal-body">
            <div class="cc-panel-body">
                <div class="cc-viewer" id="cc-viewer" data-cc-viewer>
                    <div class="cc-viewer-empty" data-cc-viewer-empty>
                        <p class="cc-empty-title">No 3D model yet</p>
                        <p class="mb-0">Press <strong>Run &#9654;</strong> on the script to see the STEP solid here.</p>
                    </div>
                </div>

                <div class="cc-viewer-toolbar">
                    <button type="button" class="cc-btn cc-btn-small cc-btn-ghost" data-cc-viewer-fit>Fit view</button>
                    <button type="button" class="cc-btn cc-btn-small cc-btn-ghost" data-cc-viewer-wire>Wireframe</button>
                    <span class="cc-viewer-hint">Drag to rotate &middot; right-drag to pan &middot; scroll to zoom</span>
                </div>
            </div>
        </div>
    </div>
</dialog>

<dialog class="cc-modal cc-modal-wide" id="cc-modal-components" aria-labelledby="cc-modal-components-title">
    <div class="cc-modal-shell">
        <header class="cc-modal-header">
            <h2 class="cc-modal-title" id="cc-modal-components-title">Recognized Components</h2>
            <button type="button" class="cc-modal-close" data-cc-close aria-label="Close recognized components">&times;</button>
        </header>

        <div class="cc-modal-body">
            <partial name="_ComponentStatsTable" model="Model" />
        </div>
    </div>
</dialog>

<dialog class="cc-modal cc-modal-wide" id="cc-modal-breakdown" aria-labelledby="cc-modal-breakdown-title">
    <div class="cc-modal-shell">
        <header class="cc-modal-header">
            <h2 class="cc-modal-title" id="cc-modal-breakdown-title">Component Breakdown</h2>
            <button type="button" class="cc-modal-close" data-cc-close aria-label="Close component breakdown">&times;</button>
        </header>

        <div class="cc-modal-body">
            <partial name="_AssemblyBreakdown" model="Model" />
        </div>
    </div>
</dialog>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="~/js/entity-hover.js" asp-append-version="true"></script>
    <script src="~/js/sandbox.js" asp-append-version="true"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
}
