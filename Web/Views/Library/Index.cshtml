@model CadToCode.Models.Dtos.CadLibraryIndexViewModel

@{
    ViewData["Title"] = "CAD Library";
}
<style>
    #reviewSection .table { --bs-table-bg: transparent; --bs-table-color: var(--cc-ink); --bs-table-border-color: var(--cc-line); color: var(--cc-ink); }
    #reviewBody td { color: var(--cc-ink) !important; }
    #reviewBody td:nth-child(2) { color: var(--cc-ink-soft) !important; font-size: 0.8rem; letter-spacing: 0.04em; }
    #reviewBody .text-muted { color: var(--cc-cyan) !important; font-family: var(--cc-font-mono); font-size: 0.75rem; }
    #reviewSection .form-control, #reviewSection .form-select { background: var(--cc-surface-sunken); border: 1px solid var(--cc-line-strong); color: var(--cc-ink); }
    #reviewSection .form-control:focus, #reviewSection .form-select:focus { border-color: var(--cc-accent); box-shadow: 0 0 0 0.2rem var(--cc-accent-soft); }
    #resultsSection .list-group { border-radius: var(--cc-radius-sm); overflow: hidden; }
    #resultsSection .list-group-item { background: var(--cc-surface-raised) !important; border-color: var(--cc-line) !important; color: var(--cc-ink) !important; }
    #resultsSection .list-group-item:hover { background: rgba(255, 122, 89, 0.06) !important; }
</style>

<div class="cc-topbar">
    <div>
        <h1 class="cc-page-title">CAD Library</h1>
        <p class="cc-page-meta">Reference .dxf, .step and C# procedural templates. Each item is embedded and stored in the cloud vector library, so the CAD Assistant can retrieve the closest C# templates for your drawings and prompts.</p>
    </div>

    <div class="d-flex gap-2">
        <a class="cc-btn cc-btn-ghost" asp-controller="Project" asp-action="Upload">Upload drawing</a>
    </div>
</div>

@if (TempData["LibraryError"] is string libraryError)
{
    <div class="cc-alert cc-alert-error" role="alert">@libraryError</div>
}

@if (TempData["LibraryMessage"] is string libraryMessage)
{
    <div class="cc-alert cc-alert-success" role="status">@libraryMessage</div>
}

<partial name="_CadLibrary" model="Model" />
