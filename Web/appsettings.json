    "MaxTokens": 384,
    "Temperature": 0.1,
    "TopP": 0.9,
    "InferenceTimeoutSeconds": 180,
    "MaxRetries": 0,
    "MinConfidence": 0.5,
    "VectorStorePath": "App_Data/patterns.json",
    "EmbeddingDimensions": 64,
    "TopKPatterns": 3,
    "MinSimilarity": 0.6,
    "SeedBuiltInPatterns": true
  },
  "LocalAiOptions": {
    "Enabled": true,
    "ModelPath": "Models/cadtocode-assist.gguf",
    "ChatTemplate": "chatml",
    "ContextSize": 4096,
    "Threads": 0,
    "GpuLayerCount": 0,
    "MaxTokens": 768,
    "Temperature": 0.1,
    "TopP": 0.9,
    "InferenceTimeoutSeconds": 300,
