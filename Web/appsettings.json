{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=cadtocode;User=root;Password=root;"
  },
  "UploadOptions": {
    "AllowedExtensions": [ ".dxf", ".png", ".jpg", ".jpeg" ],
    "MaxFileSizeMb": 20,
    "StorageRoot": ""
  },
  "ExtractionOptions": {
    "DimensionTolerancePercent": 2.0,
    "AngleToleranceDegrees": 1.0,
    "ParallelLineToleranceDegrees": 1.0,
    "OcrConfidenceThreshold": 0.60,
    "TessdataPath": "tessdata"
  },
  "LlmOptions": {
    "Enabled": true,
    "ModelPath": "Models/Phi-3-mini-4k-instruct-q4.gguf",
    "ContextSize": 2048,
    "Threads": 0,
    "MaxTokens": 384,
    "Temperature": 0.1,
    "TopP": 0.9,
    "InferenceTimeoutSeconds": 180,
    "MaxRetries": 0,
    "MinConfidence": 0.5,
    "VectorStorePath": "App_Data/patterns.json",
    "EmbeddingDimensions": 64,
    "TopKPatterns": 3,
    "MinSimilarity": 0.6,
    "SeedBuiltInPatterns": true
  },
  "LocalAiOptions": {
    "Enabled": true,
    "ModelPath": "Models/cadtocode-assist.gguf",
    "ChatTemplate": "chatml",
    "ContextSize": 8192,
    "Threads": 0,
    "GpuLayerCount": 0,
    "MaxTokens": 1536,
    "Temperature": 0.1,
    "TopP": 0.9,
    "InferenceTimeoutSeconds": 300,
    "MaxPromptChars": 4000,
    "MaxGeometryChars": 6000,
    "MaxCurrentCodeChars": 6000,
    "MaxAttachments": 5,
    "MaxAttachmentBytes": 10485760,
    "MaxAttachmentTextChars": 4000,
    "MaxHistoryTurns": 12,
    "MaxSessions": 200,
    "SessionIdleMinutes": 240,
    "AutoVerifyCode": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}