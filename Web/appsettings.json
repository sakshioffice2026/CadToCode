{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=cadtocode;User=root;Password=root;"
  },
  "UploadOptions": {
    "AllowedExtensions": [ ".dxf", ".png", ".jpg", ".jpeg" ],
    "MaxFileSizeMb": 20,
    "StorageRoot": ""
  },
  "ExtractionOptions": {
    "DimensionTolerancePercent": 2.0,
    "AngleToleranceDegrees": 1.0,
    "ParallelLineToleranceDegrees": 1.0,
    "OcrConfidenceThreshold": 0.60,
    "TessdataPath": "tessdata"
  },
  "LlmOptions": {
    "Enabled": true,
    "ModelPath": "Models/Phi-3-mini-4k-instruct-q4.gguf",
    "ContextSize": 1500,
    "Threads": 0,
    "MaxTokens": 250,
    "Temperature": 0.1,
    "TopP": 0.9,
    "InferenceTimeoutSeconds": 180,
    "MaxRetries": 0,
    "MinConfidence": 0.5,
    "VectorStorePath": "App_Data/patterns.json",
    "EmbeddingDimensions": 64,
    "TopKPatterns": 3,
    "MinSimilarity": 0.6,
    "SeedBuiltInPatterns": true
  },
  "LocalAiOptions": {
    "Enabled": true,
    "ModelPath": "Models/cadtocode-assist.gguf",
    "ChatTemplate": "chatml",
    "ContextSize": 4096,
    "Threads": 0,
    "GpuLayerCount": 0,
    "MaxTokens": 768,
    "Temperature": 0.1,
    "TopP": 0.9,
    "InferenceTimeoutSeconds": 300,
    "MaxPromptChars": 2000,
    "MaxGeometryChars": 3000,
    "MaxCurrentCodeChars": 2000,
    "MaxAttachments": 5,
    "MaxAttachmentBytes": 10485760,
    "MaxAttachmentTextChars": 1500,
    "MaxHistoryTurns": 2,
    "MaxSessions": 200,
    "SessionIdleMinutes": 240,
    "AutoVerifyCode": true
  },
  "QdrantOptions": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 6334,
    "UseHttps": false,
    "ApiKey": "",
    "CollectionName": "cad_templates",
    "VectorSize": 768,
    "TopK": 3,
    "MinScore": 0.55,
    "TimeoutSeconds": 30,
    "AutoCreateCollection": true
  },
  "GeminiEmbeddingOptions": {
    "Enabled": true,
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "gemini-embedding-001",
    "OutputDimensionality": 768,
    "MaxInputChars": 8000,
    "MaxBatchSize": 100,
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 1500
