    "ContextSize": 1096,
    "Threads": 0,
    "GpuLayerCount": 0,
    "MaxImageEdgePixels": 1024,
    "JpegQuality": 85,
    "MaxImageBytes": 20971520,
    "MaxTokens": 768,
    "Temperature": 0.1,
    "TopP": 0.9,
    "InferenceTimeoutSeconds": 120,
    "IdleUnloadMinutes": 10,
    "MaxComponents": 40,
    "MaxDimensions": 60
  },
  "QdrantOptions": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 6334,
    "UseHttps": false,
    "ApiKey": "",
    "CollectionName": "cad_templates",
    "VectorSize": 768,
    "TopK": 3,
    "MinScore": 0.55,
    "TimeoutSeconds": 10,
    "AutoCreateCollection": true
  },
  "GeminiEmbeddingOptions": {
    "Enabled": true,
    "ApiKey": "YOUR_GEMINI_API_KEY",
